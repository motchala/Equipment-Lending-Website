# PUPSync: uploaded files must never run as scripts. They stay downloadable (the document viewer shows them by URL).
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
