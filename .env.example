# ── Database ──────────────────────────────────────────────────
# XAMPP defaults. Change these only if your MySQL uses a different user/password.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=lending_db

# ── Mailer (optional) ─────────────────────────────────────────
# Gmail address + Google App Password. Leave blank to skip email notices.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=PUPSync Notifications

# ── AI Chatbot (optional) ─────────────────────────────────────
# Leave blank if you are not using the room assistant.
GROQ_API_KEY=

# Google API key with Sheets API + Drive API enabled.
# Used for live inventory sync from Google Sheets.
# Leave blank to use manual "Sync Now" only.
GOOGLE_SHEETS_API_KEY=

# ── Google OAuth (Sheets sync — optional) ─────────────────────
# OAuth 2.0 credentials from Google Cloud Console.
# Leave blank if not using the Google Sheets inventory sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary image storage (required for equipment photos) ──
# Sign up free at cloudinary.com. Find these in Dashboard → API Keys.
# CLOUDINARY_FOLDER is the folder name inside your Cloudinary media library.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=equipment
