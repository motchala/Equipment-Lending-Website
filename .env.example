# ── Database ──────────────────────────────────────────────────
# XAMPP defaults. Change these only if your MySQL uses a different user/password.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=lending_db

# ── Mailer (optional) ─────────────────────────────────────────
# Gmail address + Google App Password. Leave blank to skip email notices.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=PUPSync Notifications

# ── AI Chatbot (optional) ─────────────────────────────────────
# Leave blank if you are not using the room assistant.
AI_API_KEY=
AI_API_KEY2=
AI_API_KEY3=
GROQ_API_KEY=
