DirectoryIndex landing-page.php
Options -Indexes
# PUPSync: never serve the secrets file. If this block ever causes an HTTP 500, delete these lines (down to </Files>).
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"

    # Anti-clickjacking: X-Frame-Options (legacy browsers)
    Header always set X-Frame-Options "DENY"

    # CSP is set per-page by PHP with a unique nonce (see admin-functions.php, etc.).
    # The line below was removed because on servers where mod_headers fires alongside
    # PHP-FPM/FastCGI, 'setifempty' may still emit a SECOND CSP header that lacks the
    # PHP-generated nonce. Browsers enforce all CSP headers simultaneously, so this
    # caused the nonce-bearing inline scripts to be blocked, breaking modal buttons.
    # Header setifempty Content-Security-Policy "..." <-- intentionally disabled

    Header unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # NOTE: Cookie HttpOnly/SameSite flags are set directly by PHP (session.php,
    # remember-me.php) via ini_set and setcookie() options. The mod_headers
    # "edit Set-Cookie" line was removed because it appended duplicate attributes
    # (e.g. SameSite=Strict twice) which caused browsers on some hosting
    # environments (InfinityFree) to reject or misparse the cookie entirely,
    # breaking the Remember-Me persistent login.
</IfModule>

<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Strict
    php_value session.cookie_path /
    php_value session.use_strict_mode 1
</IfModule>

<IfModule mod_php8.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Strict
    php_value session.cookie_path /
    php_value session.use_strict_mode 1
</IfModule>
