DirectoryIndex landing-page.php

# ── Performance: GZIP compression ────────────────────────────────────────────
# Compresses HTML, CSS, JS, JSON before sending over the network.
# Reduces transfer size by ~70% — biggest single improvement on slow connections.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript text/plain text/xml application/json
</IfModule>

# ── Performance: Browser caching ──────────────────────────────────────────────
# Tells the browser to reuse downloaded files instead of re-downloading every visit.
# CSS/JS cached for 7 days; images/fonts cached for 30–90 days.
# Cache is automatically busted by the ?v= version query strings already on JS/CSS tags.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                       "access plus 7 days"
    ExpiresByType application/javascript         "access plus 7 days"
    ExpiresByType text/javascript                "access plus 7 days"
    ExpiresByType image/jpeg                     "access plus 30 days"
    ExpiresByType image/png                      "access plus 30 days"
    ExpiresByType image/webp                     "access plus 30 days"
    ExpiresByType image/svg+xml                  "access plus 30 days"
    ExpiresByType image/x-icon                   "access plus 90 days"
    ExpiresByType font/woff2                     "access plus 90 days"
    ExpiresByType application/font-woff2         "access plus 90 days"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"

    # Anti-clickjacking: X-Frame-Options (legacy browsers)
    Header always set X-Frame-Options "DENY"

    # CSP is set per-page by PHP with a unique nonce (see admin-functions.php, etc.).
    # The line below was removed because on servers where mod_headers fires alongside
    # PHP-FPM/FastCGI, 'setifempty' may still emit a SECOND CSP header that lacks the
    # PHP-generated nonce. Browsers enforce all CSP headers simultaneously, so this
    # caused the nonce-bearing inline scripts to be blocked, breaking modal buttons.
    # Header setifempty Content-Security-Policy "..." <-- intentionally disabled

    Header unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Fix: Cookie No HttpOnly Flag (ZAP)
    Header always edit Set-Cookie ^(.*)$ "$1; HttpOnly; SameSite=Strict"
</IfModule>

<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Strict
    php_value session.cookie_path /
    php_value session.use_strict_mode 1
</IfModule>

<IfModule mod_php8.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Strict
    php_value session.cookie_path /
    php_value session.use_strict_mode 1
</IfModule>
